# Polymarket Trader — environment variables
# Copy this file to .env and fill in your values.

# ── Safety ──────────────────────────────────────────────────────────────────
# Keep True during all development and paper-trading phases.
# Set to False only when ready for live trading with real funds.
PAPER_TRADING=True

# ── AI / LLM ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx
LLM_MODEL=claude-sonnet-4-6

# ── Data sources ─────────────────────────────────────────────────────────────
# CoinGecko free-tier demo key (prefix CG-)
COINGECKO_API_KEY=CG-xxxxxxxxxxxxxxxxxxxx

# ── Scanner ──────────────────────────────────────────────────────────────────
SCAN_INTERVAL_MINUTES=15
MIN_MARKET_VOLUME=10000
MIN_MARKET_LIQUIDITY=1000
MAX_MARKETS_PER_SCAN=10
MIN_NET_EDGE=0.10
PAPER_POSITION_SIZE_USD=10.0

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///polymarket_trader.db

# ── Web UI ────────────────────────────────────────────────────────────────────
WEB_USERNAME=admin
WEB_PASSWORD=changeme

# ── Live Trading (Phase 5) ────────────────────────────────────────────────────
# Only required when PAPER_TRADING=False. NEVER commit these to git.
# Add POLYGON_PRIVATE_KEY to .gitignore or use a secrets manager.
POLYGON_PRIVATE_KEY=
POLYGON_RPC_URL=https://polygon-rpc.com
CLOB_HOST=https://clob.polymarket.com
LIVE_ORDER_TIMEOUT_MINUTES=10
FILL_MONITOR_INTERVAL_MINUTES=5
