# Polymarket Trader — environment variables
# Copy this file to .env and fill in your values.

# ── Safety ──────────────────────────────────────────────────────────────────
# Keep True during all development and paper-trading phases.
# Set to False only when ready for live trading with real funds.
PAPER_TRADING=True

# ── AI / LLM ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx
LLM_MODEL=claude-sonnet-4-6

# ── Data sources ─────────────────────────────────────────────────────────────
# CoinGecko free-tier demo key (prefix CG-)
COINGECKO_API_KEY=CG-xxxxxxxxxxxxxxxxxxxx

# ── Scanner ──────────────────────────────────────────────────────────────────
SCAN_INTERVAL_MINUTES=15
MIN_MARKET_VOLUME=10000
MIN_MARKET_LIQUIDITY=1000
MAX_MARKETS_PER_SCAN=10
MIN_NET_EDGE=0.10
PAPER_POSITION_SIZE_USD=10.0

# ── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///polymarket_trader.db

# ── Web UI ────────────────────────────────────────────────────────────────────
WEB_USERNAME=admin
WEB_PASSWORD=changeme

# ── Telegram Alerts (Phase 7) ────────────────────────────────────────────────
# 1. Message @BotFather on Telegram → create bot → copy token
# 2. Message your bot, then visit https://api.telegram.org/bot<TOKEN>/getUpdates
# 3. Copy the chat_id from the JSON response
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALERT_POSITIONS=True   # alert on every new position
TELEGRAM_ALERT_HEALTH=True      # alert when components go DOWN/UP
TELEGRAM_DAILY_SUMMARY=True     # daily P&L summary at 08:00 UTC

# ── Health Monitor (Phase 7) ──────────────────────────────────────────────────
HEALTH_CHECK_INTERVAL_MINUTES=5

# ── Balance Alert (Phase 7, live mode) ───────────────────────────────────────
MIN_USDC_ALERT_USD=20.0         # Telegram alert when wallet USDC drops below this

# ── Risk Management (Phase 6) ────────────────────────────────────────────────
# All risk params are also editable live via the Config page in the web UI.
DRAWDOWN_LIMIT_USD=50.0          # circuit breaker: pause if total P&L < -N (0=off)
MAX_OPEN_POSITIONS=10            # max concurrent open positions
MAX_EXPOSURE_USD=200.0           # max total USDC staked across all positions (0=no limit)
MAX_POSITIONS_PER_UNDERLYING=2   # max positions per crypto (BTC, ETH, SOL…)
MAX_SPREAD_PCT=0.08              # reject markets where bid/ask spread > N% of mid (0=off)
USE_KELLY_SIZING=True            # True=fractional Kelly, False=fixed position size
KELLY_FRACTION=0.25              # fraction of full Kelly (0.25=quarter-Kelly)
PAPER_BANKROLL_USD=1000.0        # virtual bankroll for Kelly calculation
MAX_POSITION_SIZE_USD=50.0       # hard cap per trade regardless of Kelly output

# ── Live Trading (Phase 5) ────────────────────────────────────────────────────
# Only required when PAPER_TRADING=False. NEVER commit these to git.
# Add POLYGON_PRIVATE_KEY to .gitignore or use a secrets manager.
POLYGON_PRIVATE_KEY=
POLYGON_RPC_URL=https://polygon-rpc.com
CLOB_HOST=https://clob.polymarket.com
LIVE_ORDER_TIMEOUT_MINUTES=10
FILL_MONITOR_INTERVAL_MINUTES=5
